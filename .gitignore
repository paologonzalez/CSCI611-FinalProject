# ============================================================================
# CSCI611-FinalProject .gitignore
# ============================================================================
# Goal: keep the repo limited to source code, configs, and small artifacts.
# Datasets, virtual environments, model checkpoints, and runtime outputs all
# stay local to each teammate's machine.
# ============================================================================

# ---- Python ---------------------------------------------------------------
# Compiled bytecode and caches; regenerated automatically on every run.
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- Virtual environment --------------------------------------------------
# README tells everyone to create a local `venv/`. It's machine-specific
# (binaries depend on OS and Python version) and must never be committed.
venv/
.venv/
env/

# ---- Editor / OS noise ----------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- Notebook checkpoints --------------------------------------------------
.ipynb_checkpoints/

# ---- Model checkpoints / weights -------------------------------------------
# Trained PyTorch weights are large (tens to hundreds of MB) and easy to
# regenerate with the training scripts. Don't commit them.
*.pt
*.pth
*.onnx
*.ckpt

# ---- Training / Optuna outputs --------------------------------------------
# We TRACK outputs/ so teammates can pull the report, eval results, the
# Optuna study DBs, and the single BEST checkpoint per architecture (enough
# to re-run evaluation and Grad-CAM from a fresh clone). Trial checkpoints
# other than those three winners stay local -- they're large and easy to
# regenerate by re-running the sweeps.
runs/
*.db
*.sqlite
*.sqlite3

# Re-include the per-arch Optuna study databases (small; useful for resuming
# a search or for `report.py` to rebuild plots).
!outputs/optuna_studies/*.db

# Re-include just the winning checkpoint per architecture. The global `*.pt`
# rule above still excludes every other trial's weights.
!outputs/checkpoints/mobilenet_v2/trial_29/mobilenet_v2_trial29_best.pt
!outputs/checkpoints/efficientnet_b0/trial_5/efficientnet_b0_trial5_best.pt
!outputs/checkpoints/resnet50/trial_18/resnet50_trial18_best.pt

# ---- Dataset --------------------------------------------------------------
# The dataset lives at ../dataset (sibling of the repo) by team convention,
# so it shouldn't appear inside the repo. This entry is a safety net in case
# someone accidentally copies it in.
dataset/
data/

# ---- Large media ----------------------------------------------------------
*.mp4
*.mov
*.avi

# ---- Build / packaging ----------------------------------------------------
build/
dist/
*.egg-info/
